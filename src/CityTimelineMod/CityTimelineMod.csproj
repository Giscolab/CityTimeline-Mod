<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release</Configurations>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    <Nullable>disable</Nullable>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</RepositoryRoot>
    <ResourcesRoot>$(RepositoryRoot)\resources</ResourcesRoot>
    <PackagingRoot>$(RepositoryRoot)\packaging</PackagingRoot>
    <UiOutputRoot>$(RepositoryRoot)\src\CityTimelineMod.UI\dist</UiOutputRoot>
    <GameManagedRoot>C:\Program Files (x86)\Steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</GameManagedRoot>
    <CityTimelineCleanPublish Condition="'$(CityTimelineCleanPublish)' == ''">false</CityTimelineCleanPublish>
    <CityTimelinePublishStagingRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\publish-staging'))</CityTimelinePublishStagingRoot>
    <CityTimelineDeployBackup>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\deploy-runtime-backup'))</CityTimelineDeployBackup>
    <CSII_TOOLPATH Condition="'$(CSII_TOOLPATH)' == ''">$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</CSII_TOOLPATH>
    <CSII_TOOLPATH Condition="'$(CSII_TOOLPATH)' == ''">$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.UserProfile)), 'AppData\LocalLow\Colossal Order\Cities Skylines II\.cache\Modding'))</CSII_TOOLPATH>
  </PropertyGroup>

  <Import Project="$(CSII_TOOLPATH)\Mod.props" />
  <Import Project="$(CSII_TOOLPATH)\Mod.targets" />

  <ItemGroup>
    <Reference Include="Game"><Private>false</Private></Reference>
    <Reference Include="Colossal.Core"><Private>false</Private></Reference>
    <Reference Include="Colossal.Logging"><Private>false</Private></Reference>
    <Reference Include="Colossal.Localization"><Private>false</Private></Reference>
    <Reference Include="Colossal.IO.AssetDatabase"><Private>false</Private></Reference>
    <Reference Include="Colossal.UI.Binding"><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameManagedRoot)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(GameManagedRoot)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(GameManagedRoot)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GameManagedRoot)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.RenderPipelines.HighDefinition.Runtime"><HintPath>$(GameManagedRoot)\Unity.RenderPipelines.HighDefinition.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Burst"><Private>false</Private></Reference>
    <Reference Include="Unity.Collections"><Private>false</Private></Reference>
    <Reference Include="Unity.Entities"><Private>false</Private></Reference>
    <Reference Include="Unity.Mathematics"><Private>false</Private></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(GameManagedRoot)\Colossal.Mathematics.dll</HintPath><Private>false</Private></Reference>
    <Reference Update="System"><Private>false</Private></Reference>
    <Reference Update="System.Core"><Private>false</Private></Reference>
    <Reference Update="System.Data"><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime;native;contentfiles;analyzers;buildtransitive</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Lib.Harmony" Version="2.2.2" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
    <None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
  </ItemGroup>

  <ItemGroup>
    <!-- GeoJSON remains a visual/informational overlay. The former road
         import, snapping and spawning implementation stays excluded. -->
    <Compile Remove="Roads\**\*.cs" />
    <!-- Reuse only the read-only road profile and prefab resolver so the
         visual ribbon can use the selected vanilla prefab width. -->
    <Compile Include="Roads\Model\RoadImportMetadata.cs" />
    <Compile Include="Roads\Prefabs\RoadPrefabResolver.cs" />
    <Compile Remove="Systems\RuntimeRoadToolDriverSystem.cs" />
    <Compile Remove="LargeMap\AirOutsideConnectionRepairSystem.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(ResourcesRoot)\defaults\config.json" Link="Resources\config.json" />
    <EmbeddedResource Include="$(ResourcesRoot)\legacy-geojson\water_lines_clipped.geojson" Link="Resources\legacy-geojson\water_lines_clipped.geojson" />
    <EmbeddedResource Include="$(ResourcesRoot)\legacy-geojson\water_areas_clipped.geojson" Link="Resources\legacy-geojson\water_areas_clipped.geojson" />
    <EmbeddedResource Include="$(ResourcesRoot)\legacy-geojson\roads_major_clipped.geojson" Link="Resources\legacy-geojson\roads_major_clipped.geojson" />
    <EmbeddedResource Include="$(ResourcesRoot)\legacy-geojson\zoning_polygons.geojson" Link="Resources\legacy-geojson\zoning_polygons.geojson" />
    <EmbeddedResource Include="$(ResourcesRoot)\legacy-geojson\bbox_manifest.json" Link="Resources\legacy-geojson\bbox_manifest.json" />
	
	
  </ItemGroup>


  <ItemGroup>
    <!-- Generic CTM material-map pipeline:
         every shader map below resources\textures is embedded automatically. -->
    <EmbeddedResource Include="$(ResourcesRoot)\textures\**\_*.png">
      <Link>Resources\textures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="$(ResourcesRoot)\textures\**\*.json">
      <Link>Resources\textures\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>
  <!--
    DeployWIP supplied by the CS2 toolchain deletes $(DeployDir) before copying
    the new build. RealMap publishes runtime-owned bundles directly below that
    local deployment directory, so preserve them and the legacy migration
    config across local IDE/dotnet deployments. The writable ModsSettings config
    lives outside DeployDir and is never part of this preservation path.
  -->
  <Target Name="PrepareCityTimelineCleanPublishStaging"
          BeforeTargets="DeployWIP"
          Condition="'$(CityTimelineCleanPublish)' == 'true'">
    <PropertyGroup>
      <CityTimelineExpectedCleanDeployDir>$([System.IO.Path]::GetFullPath('$(CityTimelinePublishStagingRoot)\$(TargetName)'))</CityTimelineExpectedCleanDeployDir>
      <CityTimelineActualCleanDeployDir>$([System.IO.Path]::GetFullPath('$(DeployDir)'))</CityTimelineActualCleanDeployDir>
    </PropertyGroup>

    <Error Condition="'$(CityTimelineActualCleanDeployDir)' != '$(CityTimelineExpectedCleanDeployDir)'"
           Text="CityTimelineMod clean publication is restricted to $(CityTimelineExpectedCleanDeployDir), not $(CityTimelineActualCleanDeployDir)." />
    <RemoveDir Directories="$(CityTimelinePublishStagingRoot)" />
  </Target>

  <Target Name="PreserveCityTimelineRuntimeData"
          BeforeTargets="DeployWIP"
          Condition="'$(CityTimelineCleanPublish)' != 'true'">
    <PropertyGroup>
      <CityTimelineCanonicalBundles>$(DeployDir)\data\exports\bundles</CityTimelineCanonicalBundles>
      <CityTimelineLegacyBundles>$(DeployDir)\data\bundles</CityTimelineLegacyBundles>
      <CityTimelineRuntimeBundlesRoot Condition="Exists('$(CityTimelineCanonicalBundles)\bundle_index.json')">$(CityTimelineCanonicalBundles)</CityTimelineRuntimeBundlesRoot>
      <CityTimelineRuntimeBundlesRoot Condition="'$(CityTimelineRuntimeBundlesRoot)' == '' AND Exists('$(CityTimelineLegacyBundles)\bundle_index.json')">$(CityTimelineLegacyBundles)</CityTimelineRuntimeBundlesRoot>
    </PropertyGroup>

    <RemoveDir Directories="$(CityTimelineDeployBackup)" />

    <ItemGroup>
      <CityTimelineRuntimeConfig Include="$(DeployDir)\config.json"
                                 Condition="Exists('$(DeployDir)\config.json')" />
      <CityTimelineRuntimeBundles Include="$(CityTimelineRuntimeBundlesRoot)\**\*.*"
                                  Condition="'$(CityTimelineRuntimeBundlesRoot)' != ''" />
    </ItemGroup>

    <Copy SourceFiles="@(CityTimelineRuntimeConfig)"
          DestinationFolder="$(CityTimelineDeployBackup)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CityTimelineRuntimeBundles)"
          DestinationFiles="@(CityTimelineRuntimeBundles->'$(CityTimelineDeployBackup)\bundles\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CityTimelineDeployContent" AfterTargets="DeployWIP">
    <ItemGroup>
      <CityTimelineRootFiles Include="$(PackagingRoot)\mod.json" />
      <CityTimelineRootFiles Include="$(ResourcesRoot)\defaults\config.json" />
      <CityTimelineDataFiles Include="$(ResourcesRoot)\legacy-geojson\**\*.*" />
      <CityTimelineUiRootFiles Include="$(UiOutputRoot)\CityTimelineMod.mjs" Condition="Exists('$(UiOutputRoot)\CityTimelineMod.mjs')" />
      <CityTimelineUiRootFiles Include="$(UiOutputRoot)\CityTimelineMod.css" Condition="Exists('$(UiOutputRoot)\CityTimelineMod.css')" />
      <CityTimelineUiLicenseFile Include="$(UiOutputRoot)\CityTimelineMod.mjs.LICENSE.txt"
                                 Condition="Exists('$(UiOutputRoot)\CityTimelineMod.mjs.LICENSE.txt')" />
      <CityTimelineUiFontFiles Include="$(UiOutputRoot)\fonts\**\*.*" Condition="Exists('$(UiOutputRoot)\fonts')" />
    </ItemGroup>

    <Copy SourceFiles="@(CityTimelineRootFiles)"
          DestinationFiles="@(CityTimelineRootFiles->'$(DeployDir)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(CityTimelineDataFiles)"
          DestinationFiles="@(CityTimelineDataFiles->'$(DeployDir)\data\legacy-geojson\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(CityTimelineUiRootFiles)"
          DestinationFiles="@(CityTimelineUiRootFiles->'$(DeployDir)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- Keep the generated third-party notice as an explicit publication
         artifact. Its multi-part extension must not depend on generic item
         metadata transforms used by the other UI root files. -->
    <Copy SourceFiles="@(CityTimelineUiLicenseFile)"
          DestinationFiles="@(CityTimelineUiLicenseFile->'$(DeployDir)\CityTimelineMod.mjs.LICENSE.txt')"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="@(CityTimelineUiFontFiles)"
          DestinationFiles="@(CityTimelineUiFontFiles->'$(DeployDir)\fonts\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <ItemGroup Condition="'$(CityTimelineCleanPublish)' != 'true'">
      <CityTimelinePreservedConfig Include="$(CityTimelineDeployBackup)\config.json"
                                   Condition="Exists('$(CityTimelineDeployBackup)\config.json')" />
      <CityTimelinePreservedBundles Include="$(CityTimelineDeployBackup)\bundles\**\*.*"
                                    Condition="Exists('$(CityTimelineDeployBackup)\bundles')" />
    </ItemGroup>

    <!-- Restore runtime-owned state after repository defaults have deployed. -->
    <Copy SourceFiles="@(CityTimelinePreservedConfig)"
          DestinationFiles="@(CityTimelinePreservedConfig->'$(DeployDir)\config.json')"
          Condition="'$(CityTimelineCleanPublish)' != 'true'" />
    <Copy SourceFiles="@(CityTimelinePreservedBundles)"
          DestinationFiles="@(CityTimelinePreservedBundles->'$(DeployDir)\data\exports\bundles\%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="'$(CityTimelineCleanPublish)' != 'true'" />

    <Error Condition="!Exists('$(DeployDir)\0Harmony.dll')"
           Text="CityTimelineMod deployment is incomplete: 0Harmony.dll is missing from $(DeployDir)." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\CityTimelineMod.dll')"
           Text="CityTimelineMod publication staging is incomplete: CityTimelineMod.dll is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\CityTimelineMod_win_x86_64.dll')"
           Text="CityTimelineMod publication staging is incomplete: Windows native output is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\CityTimelineMod_mac_x86_64.bundle')"
           Text="CityTimelineMod publication staging is incomplete: macOS native output is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\CityTimelineMod_linux_x86_64.so')"
           Text="CityTimelineMod publication staging is incomplete: Linux native output is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\CityTimelineMod.mjs')"
           Text="CityTimelineMod publication staging is incomplete: CityTimelineMod.mjs is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\CityTimelineMod.css')"
           Text="CityTimelineMod publication staging is incomplete: CityTimelineMod.css is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND '@(CityTimelineUiLicenseFile)' == ''"
           Text="CityTimelineMod publication staging is incomplete: the generated UI license notice is missing from $(UiOutputRoot)." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\CityTimelineMod.mjs.LICENSE.txt')"
           Text="CityTimelineMod publication staging is incomplete: the generated UI license notice is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\fonts\Overpass-Regular.ttf')"
           Text="CityTimelineMod publication staging is incomplete: fonts\Overpass-Regular.ttf is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\config.json')"
           Text="CityTimelineMod publication staging is incomplete: root config.json is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND !Exists('$(DeployDir)\mod.json')"
           Text="CityTimelineMod publication staging is incomplete: root mod.json is missing." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND Exists('$(DeployDir)\data\exports\bundles')"
           Text="CityTimelineMod publication staging must not contain external bundles: $(DeployDir)\data\exports\bundles." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND Exists('$(DeployDir)\data\bundles')"
           Text="CityTimelineMod publication staging must not contain legacy external bundles: $(DeployDir)\data\bundles." />
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND Exists('$(DeployDir)\ModsSettings')"
           Text="CityTimelineMod publication staging must not contain user settings: $(DeployDir)\ModsSettings." />

    <GetFileHash Files="$(ResourcesRoot)\defaults\config.json"
                 Algorithm="SHA256"
                 Condition="'$(CityTimelineCleanPublish)' == 'true'">
      <Output TaskParameter="Items" ItemName="_CityTimelineDefaultConfigHash" />
    </GetFileHash>
    <GetFileHash Files="$(DeployDir)\config.json"
                 Algorithm="SHA256"
                 Condition="'$(CityTimelineCleanPublish)' == 'true'">
      <Output TaskParameter="Items" ItemName="_CityTimelineStagedConfigHash" />
    </GetFileHash>
    <PropertyGroup Condition="'$(CityTimelineCleanPublish)' == 'true'">
      <_CityTimelineDefaultConfigHashValue>@(_CityTimelineDefaultConfigHash->'%(FileHash)')</_CityTimelineDefaultConfigHashValue>
      <_CityTimelineStagedConfigHashValue>@(_CityTimelineStagedConfigHash->'%(FileHash)')</_CityTimelineStagedConfigHashValue>
    </PropertyGroup>
    <Error Condition="'$(CityTimelineCleanPublish)' == 'true' AND '$(_CityTimelineDefaultConfigHashValue)' != '$(_CityTimelineStagedConfigHashValue)'"
           Text="CityTimelineMod publication staging config.json differs from resources\defaults\config.json." />

    <RemoveDir Directories="$(CityTimelineDeployBackup)"
               Condition="'$(CityTimelineCleanPublish)' != 'true'" />
  </Target>

  <!-- DeployWIP snapshots $(OutDir), so Harmony must be present before it runs. -->
  <Target Name="CopyHarmonyToOutput" BeforeTargets="DeployWIP">
    <ItemGroup>
      <HarmonyRuntime Include="$(PkgLib_Harmony)\lib\net472\0Harmony.dll" Condition="Exists('$(PkgLib_Harmony)\lib\net472\0Harmony.dll')" />
      <HarmonyRuntime Include="$(PkgLib_Harmony)\lib\net48\0Harmony.dll" Condition="Exists('$(PkgLib_Harmony)\lib\net48\0Harmony.dll')" />
      <HarmonyRuntime Include="$(PkgLib_Harmony)\lib\netstandard2.0\0Harmony.dll" Condition="Exists('$(PkgLib_Harmony)\lib\netstandard2.0\0Harmony.dll')" />
    </ItemGroup>
    <Error Condition="'@(HarmonyRuntime)' == ''"
           Text="Lib.Harmony 2.2.2 runtime assembly was not found in the NuGet package cache." />
    <Copy SourceFiles="@(HarmonyRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

