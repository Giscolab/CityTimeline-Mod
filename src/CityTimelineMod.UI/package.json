{
  "name": "citytimeline-ui",
  "version": "0.1.2",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {

    "verify:bindings": "node scripts/verify-bindings.mjs",
    "verify:css": "node scripts/verify-css-scope.mjs",
    "build": "npm run verify:bindings && npm run verify:css && webpack --config webpack.config.js --mode production",
    "dev": "webpack --config webpack.config.js --mode development --watch",
	"preview": "webpack serve --config webpack.preview.config.js --mode development",
	"preview:build": "webpack --config webpack.preview.config.js --mode development"
  },
  "dependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "css-loader": "^7.1.4",
    "mini-css-extract-plugin": "^2.10.2",
    "react-dom": "^18.3.1",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
